# Copia este archivo, renómbralo a .env y pega tu clave real.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
GEMINI_API_KEY=pega-aqui-tu-clave
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Seguridad (Guía 7) ---
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=pega-aqui-una-clave-larga-y-aleatoria
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Poner en false en producción para ocultar /docs
ENABLE_DOCS=true

# --- Producción con Docker (Guía 8) ---
# Contraseña de PostgreSQL para docker-compose (inventa una larga; solo vive en tu .env)
POSTGRES_PASSWORD=pega-aqui-una-clave-para-la-base-de-datos
# Primer usuario ADMIN: se crea al arrancar SOLO si la base de datos no tiene usuarios (mínimo 12 caracteres)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pega-aqui-una-clave-de-12-o-mas-caracteres
# DATABASE_URL: NO se pone aquí. docker-compose la arma sola y en Render se copia la "Internal Database URL".
# Si no existe, la API usa SQLite (enlace_sonoro.db) como en las guías anteriores.
